{
  "name": "exaf-staff-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=prisma/schema && nest build",
    "start": "dotenv -e .env.local -- nest start",
    "start:dev": "dotenv -e .env.local -- nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema=prisma/schema",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev --schema=prisma/schema",
    "prisma:migrate:name": "dotenv -e .env.local -- prisma migrate dev --schema=prisma/schema --name",
    "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy --schema=prisma/schema",
    "prisma:migrate:status": "dotenv -e .env.local -- prisma migrate status --schema=prisma/schema",
    "prisma:migrate:resolve": "dotenv -e .env.local -- prisma migrate resolve --schema=prisma/schema",
    "prisma:push": "dotenv -e .env.local -- prisma db push --schema=prisma/schema",
    "prisma:pull": "dotenv -e .env.local -- prisma db pull --schema=prisma/schema",
    "prisma:reset": "dotenv -e .env.local -- prisma migrate reset --schema=prisma/schema",
    "prisma:studio": "dotenv -e .env.local -- prisma studio --config=prisma.config.ts",
    "prisma:format": "prisma format --schema=prisma/schema",
    "prisma:validate": "prisma validate --schema=prisma/schema",
    "seed": "dotenv -e .env.local -- ts-node --transpile-only prisma/seeds/seed.ts",
    "prod:seed": "dotenv -e .env -- ts-node --transpile-only prisma/seeds/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@wahyubucil/nestjs-zod-openapi": "^0.1.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "dotenv -e .env.local -- ts-node --transpile-only prisma/seeds/seed.ts"
  }
}
