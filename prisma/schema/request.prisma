enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffRequest {
  id             String        @id @default(uuid())
  organizationId String
  userId         String
  category       String
  subject        String
  details        String?
  startDate      DateTime?
  endDate        DateTime?
  status         RequestStatus @default(PENDING)
  notifyToEmails String[]      @default([])
  notifyCcEmails String[]      @default([])
  reviewedById   String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("RequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("RequestReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, userId, status])
  @@index([userId, status])
  @@index([category])
  @@map("staff_requests")
}
