enum StorageDriver {
  LOCAL
  S3
}

enum UploadEntityType {
  PROJECT
  TASK
  STAFF_REQUEST
  EVENT
}

model Upload {
  id             String        @id @default(uuid())
  organizationId String
  uploadedById   String
  originalName   String
  storedKey      String
  url            String
  mimeType       String
  sizeBytes      Int
  driver         StorageDriver

  entityType UploadEntityType?
  entityId   String?

  relativePath String?
  folderName   String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("UploadOwner", fields: [uploadedById], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id])
  taskId       String?
  event        Event?       @relation(fields: [eventId], references: [id])
  eventId      String?

  @@index([organizationId])
  @@index([entityId])
  @@index([folderName])
  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("uploads")
}
