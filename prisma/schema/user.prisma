enum Shift {
  ONSITE
  HYBRID
  REMOTE
}

model User {
  id                 String    @id @default(uuid())
  organizationId     String?
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  middleName         String?
  username           String?   @unique
  dateOfBirth        DateTime?
  departmentId       String?
  position           String    @default("UNASSIGNED")
  isIntern           Boolean   @default(false)
  officeBranchId     String?
  shift              Shift     @default(ONSITE)
  bio                String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  isPlatformAdmin    Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  attendanceExempt   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department          Department?      @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  officeBranch        OfficeBranch?    @relation(fields: [officeBranchId], references: [id], onDelete: SetNull)
  roles               UserRole[]
  attendances         Attendance[]
  staffRequests       StaffRequest[]   @relation("RequestOwner")
  reviewedRequests    StaffRequest[]   @relation("RequestReviewer")
  createdProjects     Project[]        @relation("ProjectCreator")
  projectMembers      ProjectMember[]
  assignedTasks       Task[]           @relation("AssignedTasks")
  createdTasks        Task[]           @relation("CreatedTasks")
  refreshTokens       RefreshToken[]
  screentimeLogs      ScreentimeLog[]  @relation("ScreentimeUser")
  reviewedAttendance  Attendance[]     @relation("AttendanceReviewer")
  permissionOverrides UserPermission[] @relation("UserPermissionTarget")
  grantedPermissions  UserPermission[] @relation("UserPermissionGrantor")
  activities          ActivityLog[]    @relation("ActivityUser")
  notifications       Notification[]   @relation("NotificationUser")
  uploads             Upload[]         @relation("UploadOwner")
  createdEvents       Event[]          @relation("EventCreator")
  suggestions         Suggestion[]     @relation("SuggestionCreator")
  suggestionVotes     SuggestionVote[] @relation("SuggestionVotes")
  headOfDepartments   Department[]     @relation("DepartmentHead")
  sentInvitations     Invitation[]     @relation("InviteSender")

  @@index([organizationId])
  @@index([departmentId])
  @@index([officeBranchId])
  @@index([isActive])
  @@map("users")
}
