# App
PORT=5002
NODE_ENV=development

# Postgres Database
POSTGRES_USER=staff_platform
POSTGRES_PASSWORD=development-long-random-secret
POSTGRES_DB=staff_platform_db

DATABASE_URL="postgresql://staff_platform:development-long-random-secret@localhost:5432/staff_platform_db?schema=public"
DIRECT_URL="postgresql://staff_platform:development-long-random-secret@localhost:5432/staff_platform_db?schema=public"

# Redis (Compose overrides this to redis://redis:6379 inside the api container)
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=60
CACHE_RBAC_TTL_SECONDS=3600

JWT_ACCESS_SECRET="default-staff-platform-jwt-access-secret-key"
JWT_REFRESH_SECRET="default-staff-platform-jwt-refresh-secret-key"

JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_ADMIN_EMAIL="admin@gmail.com"
PLATFORM_ADMIN_PASSWORD="password"

STORAGE_DRIVER="s3"
UPLOAD_DIR="uploads"

MAX_UPLOAD_SIZE_MB=500
MAX_DOCUMENTS_PER_UPLOAD=10

AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""
AWS_REGION="eu-central-1"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_S3_PUBLIC_BASE_URL=""

SMTP_HOST=smtp
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=""